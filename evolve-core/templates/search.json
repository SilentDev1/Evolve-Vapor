{
	"version": "0.4",
	"title": "Evolve — Search Results",
	"type": "search-results",
	"page_settings":{ "background_background":"classic","background_color":"#050505" },
	"content":[
		{
			"id":"sr-head",
			"elType":"container",
			"settings":{
				"content_width":"boxed",
				"padding":{ "unit":"px","top":"60","right":"24","bottom":"20","left":"24","isLinked":false },
				"flex_direction":"column","flex_gap":{"unit":"px","size":14,"column":"14","row":"14"}
			},
			"elements":[
				{ "id":"sr-h","elType":"widget","widgetType":"archive-title","settings":{ "title_color":"#FFFFFF","typography_typography":"custom","typography_font_family":"Poppins","typography_font_weight":"800","typography_font_size":{"unit":"px","size":40} } },
				{ "id":"sr-search","elType":"widget","widgetType":"search-form","settings":{ "button_text":"Search","placeholder":"Search products and articles…" } }
			]
		},
		{
			"id":"sr-products",
			"elType":"container",
			"settings":{
				"content_width":"boxed",
				"padding":{ "unit":"px","top":"20","right":"24","bottom":"40","left":"24","isLinked":false },
				"flex_direction":"column","flex_gap":{"unit":"px","size":18,"column":"18","row":"18"}
			},
			"elements":[
				{ "id":"sr-p-h","elType":"widget","widgetType":"heading","settings":{ "title":"Products","header_size":"h2","title_color":"#FFFFFF" } },
				{ "id":"sr-p-grid","elType":"widget","widgetType":"woocommerce-products","settings":{ "columns":4,"columns_tablet":3,"columns_mobile":2,"per_page":"8","query_post_type":"product","query_include_authors":"","filter_by":"search" } }
			]
		},
		{
			"id":"sr-articles",
			"elType":"container",
			"settings":{
				"content_width":"boxed",
				"padding":{ "unit":"px","top":"20","right":"24","bottom":"100","left":"24","isLinked":false },
				"flex_direction":"column","flex_gap":{"unit":"px","size":18,"column":"18","row":"18"}
			},
			"elements":[
				{ "id":"sr-a-h","elType":"widget","widgetType":"heading","settings":{ "title":"Articles","header_size":"h2","title_color":"#FFFFFF" } },
				{ "id":"sr-a","elType":"widget","widgetType":"archive-posts","settings":{ "classic_columns":3,"classic_show_excerpt":"yes","classic_excerpt_length":18 } }
			]
		}
	]
}
