{
	"version": "0.4",
	"title": "Evolve — Blog Archive",
	"type": "archive",
	"page_settings": { "background_background": "classic", "background_color": "#050505", "hide_title": "yes" },
	"content": [
		{
			"id": "evb00001",
			"elType": "container",
			"settings": {
				"content_width": "boxed",
				"padding": { "unit": "px", "top": "90", "right": "24", "bottom": "30", "left": "24", "isLinked": false },
				"flex_direction": "column",
				"flex_align_items": "flex-start",
				"flex_gap": { "unit": "px", "size": 10, "column": "10", "row": "10" }
			},
			"elements": [
				{ "id": "evb00002", "elType": "widget", "widgetType": "heading",
				  "settings": { "title": "VAPE NEWS", "header_size": "div", "title_color": "#B7FF00",
				    "typography_typography": "custom", "typography_font_family": "Poppins", "typography_font_weight": "700",
				    "typography_font_size": { "unit": "px", "size": 12 }, "typography_letter_spacing": { "unit": "px", "size": 3 },
				    "typography_text_transform": "uppercase" } },
				{ "id": "evb00003", "elType": "widget", "widgetType": "archive-title",
				  "settings": { "title_color": "#FFFFFF",
				    "typography_typography": "custom", "typography_font_family": "Poppins", "typography_font_weight": "900",
				    "typography_font_size": { "unit": "px", "size": 64 },
				    "typography_font_size_tablet": { "unit": "px", "size": 44 },
				    "typography_font_size_mobile": { "unit": "px", "size": 34 },
				    "typography_line_height": { "unit": "em", "size": 1.05 },
				    "typography_letter_spacing": { "unit": "px", "size": -1.2 } } },
				{ "id": "evb00004", "elType": "widget", "widgetType": "text-editor",
				  "settings": { "editor": "<p style='color:#B3B3B3;font-size:17px;max-width:680px;'>Reviews, how-tos, flavor drops, and shop news from the Evolve team. Updated weekly.</p>" } }
			]
		},
		{
			"id": "evb00005",
			"elType": "container",
			"settings": {
				"content_width": "boxed",
				"padding": { "unit": "px", "top": "30", "right": "24", "bottom": "80", "left": "24", "isLinked": false },
				"flex_direction": "column",
				"flex_gap": { "unit": "px", "size": 30, "column": "30", "row": "30" }
			},
			"elements": [
				{ "id": "evb00006", "elType": "widget", "widgetType": "archive-posts",
				  "settings": {
				    "classic_columns": 3, "classic_columns_tablet": 2, "classic_columns_mobile": 1,
				    "classic_show_excerpt": "yes", "classic_excerpt_length": 22,
				    "classic_image_size": "medium_large",
				    "classic_show_meta": "yes",
				    "classic_meta_data": ["date","author","comments"],
				    "classic_show_read_more": "yes",
				    "classic_read_more_text": "Read article →",
				    "classic_pagination": "numbers_and_prev_next",
				    "classic_pagination_align": "center",
				    "_element_id": "evolve-blog-grid" } }
			]
		},
		{
			"id": "evb00007",
			"elType": "container",
			"settings": {
				"content_width": "boxed",
				"padding": { "unit": "px", "top": "0", "right": "24", "bottom": "100", "left": "24", "isLinked": false }
			},
			"elements": [
				{ "id": "evb00008", "elType": "widget", "widgetType": "shortcode",
				  "settings": { "shortcode": "[evolve_subscribe eyebrow=\"STAY IN THE LOOP\" title=\"Get new drops &amp; deals in your inbox\" lede=\"One short email a week. New flavors, restocks, and Pheasant Lane Mall events. No spam — unsubscribe any time.\" button=\"Subscribe →\" source=\"blog_archive\" tags=\"newsletter,blog_archive\" consent=\"yes\"]" } }
			]
		}
	]
}
