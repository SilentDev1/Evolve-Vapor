				      { "tab_title": "Do you offer shipping?", "tab_content": "<p>No — we're in-store pickup only at Pheasant Lane Mall. Order online, then come pick up at the counter. Faster, fresher, no porch theft.</p>" },
				      { "tab_title": "Do I need to be 21 to enter?", "tab_content": "<p>Yes. Federal and state law: 21+ to buy any vape or tobacco product. Bring a valid photo ID — we card everyone, every time.</p>" },
				      { "tab_title": "What's the deal on the 4-juice promo?", "tab_content": "<p>Buy any 4 e-juice bottles, get the 5th free. Mix and match — the free bottle must be equal or lesser value. No code needed; we'll apply it at pickup.</p>" },
				      { "tab_title": "Can I test a flavor before I buy?", "tab_content": "<p>Yes — we have testers for most house e-juice flavors. Just ask at the counter.</p>" },
